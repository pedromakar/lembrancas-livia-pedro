<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Nossa história — <%= config.casal.nome1 %> & <%= config.casal.nome2 %>">
    <title><%= title %> — Nosso Lugar</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ─── HERO DA HISTÓRIA ─── */
        .historia-hero {
            background: linear-gradient(160deg, var(--dark) 0%, var(--dark-2) 50%, var(--bordo-dark) 100%);
            color: var(--marfim);
            padding: 6rem 1.5rem 5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .historia-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center bottom, rgba(201, 149, 108, 0.12) 0%, transparent 70%);
        }

        .historia-hero-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.8rem, 7vw, 5rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.1;
            position: relative;
        }

        .historia-hero-sub {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1rem, 2.5vw, 1.4rem);
            font-style: italic;
            font-weight: 300;
            color: var(--rose-gold);
            margin-top: 0.75rem;
            letter-spacing: 0.08em;
            position: relative;
        }

        .historia-hero-line {
            width: 60px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--rose-gold), transparent);
            margin: 1.5rem auto;
        }

        /* ─── TIMELINE ─── */
        .timeline-wrapper {
            max-width: 900px;
            margin: 0 auto;
            padding: 4rem 1.5rem 6rem;
            position: relative;
        }

        /* Linha central */
        .timeline-wrapper::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 4rem;
            bottom: 3rem;
            width: 2px;
            transform: translateX(-50%);
            background: linear-gradient(180deg,
                rgba(201, 149, 108, 0) 0%,
                var(--rose-gold) 8%,
                var(--rose-gold) 92%,
                rgba(201, 149, 108, 0) 100%
            );
        }

        @media (max-width: 700px) {
            .timeline-wrapper::before { left: 28px; }
        }

        /* ─── ITEM DE EVENTO ─── */
        .timeline-item {
            display: flex;
            justify-content: flex-end;
            padding-right: calc(50% + 2.5rem);
            margin-bottom: 4rem;
            position: relative;
        }

        .timeline-item:nth-child(even) {
            justify-content: flex-start;
            padding-right: 0;
            padding-left: calc(50% + 2.5rem);
        }

        /* Ponto central da timeline */
        .timeline-dot {
            position: absolute;
            left: 50%;
            top: 1.75rem;
            transform: translateX(-50%);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            z-index: 2;
            border: 3px solid var(--marfim);
            box-shadow: 0 0 0 3px var(--rose-gold), var(--shadow-md);
            transition: transform var(--transition-fast);
        }

        .timeline-dot.bordo-dot  { background: var(--bordo); }
        .timeline-dot.rose-dot   { background: var(--rose-gold-dark); }
        .timeline-item:hover .timeline-dot { transform: translateX(-50%) scale(1.15); }

        /* Linha horizontal de conexão */
        .timeline-connector {
            position: absolute;
            top: calc(1.75rem + 13px);
            height: 2px;
            background: linear-gradient(90deg, var(--rose-gold), rgba(201,149,108,0.2));
        }

        .timeline-item:nth-child(odd) .timeline-connector {
            right: calc(50% + 26px);
            left: 0;
            background: linear-gradient(90deg, rgba(201,149,108,0.2), var(--rose-gold));
            right: calc(50% + 26px);
            width: auto;
        }

        .timeline-item:nth-child(even) .timeline-connector {
            left: calc(50% + 26px);
            right: 0;
        }

        /* Card do evento */
        .timeline-card {
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            border: 1px solid rgba(201, 149, 108, 0.12);
            max-width: 380px;
            width: 100%;
            transition: all var(--transition-med);
            cursor: default;
        }

        .timeline-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(201, 149, 108, 0.3);
        }

        .timeline-card-header {
            padding: 1.25rem 1.5rem 0;
        }

        .timeline-data {
            font-family: 'Inter', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--rose-gold-dark);
            margin-bottom: 0.4rem;
        }

        .timeline-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--bordo);
            line-height: 1.3;
        }

        .timeline-descricao {
            font-family: 'Inter', sans-serif;
            font-size: 0.88rem;
            line-height: 1.75;
            color: var(--dark-3);
            padding: 0.75rem 1.5rem 1.25rem;
        }

        /* Foto do evento */
        .timeline-foto {
            width: 100%;
            aspect-ratio: 16/9;
            object-fit: cover;
        }

        .timeline-foto-placeholder {
            width: 100%;
            aspect-ratio: 16/9;
            background: linear-gradient(135deg, var(--marfim-dark), var(--nude-light));
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            color: var(--cor-gray);
            font-size: 0.8rem;
            font-style: italic;
        }

        /* Destaque */
        .timeline-card.destaque {
            border-color: rgba(90, 28, 53, 0.2);
            box-shadow: 0 4px 20px rgba(90, 28, 53, 0.1);
        }

        .timeline-card.destaque .timeline-titulo {
            font-size: 1.5rem;
        }

        /* Badge de destaque */
        .badge-destaque {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 0.2rem 0.65rem;
            background: rgba(90, 28, 53, 0.08);
            color: var(--bordo);
            border-radius: var(--radius-pill);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        /* Ações (editar/deletar) */
        .timeline-acoes {
            display: flex;
            gap: 0.5rem;
            padding: 0 1.5rem 1.25rem;
            border-top: 1px solid rgba(201, 149, 108, 0.1);
            padding-top: 0.75rem;
            margin-top: 0.25rem;
        }

        .btn-acao {
            font-size: 0.75rem;
            padding: 0.3rem 0.7rem;
            border-radius: var(--radius-sm);
            border: 1px solid;
            background: transparent;
            cursor: pointer;
            transition: all var(--transition-fast);
            font-family: 'Inter', sans-serif;
        }

        .btn-acao-editar {
            border-color: rgba(90, 28, 53, 0.3);
            color: var(--bordo);
        }

        .btn-acao-editar:hover {
            background: var(--bordo);
            color: var(--marfim);
        }

        .btn-acao-deletar {
            border-color: rgba(220, 80, 80, 0.3);
            color: #c0392b;
        }

        .btn-acao-deletar:hover {
            background: #c0392b;
            color: white;
        }

        /* Fim da timeline */
        .timeline-fim {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            padding: 2rem 0 0;
        }

        .timeline-fim-circulo {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--bordo), var(--rose-gold));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 0 0 6px rgba(90, 28, 53, 0.1), var(--shadow-md);
            animation: heartBeat 2s ease-in-out infinite;
        }

        .timeline-fim-texto {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-style: italic;
            color: var(--cor-gray);
            text-align: center;
        }

        /* ─── MODAL DE FORMULÁRIO ─── */
        .modal-historia {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(20, 8, 14, 0.8);
            backdrop-filter: blur(10px);
            z-index: var(--z-modal);
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .modal-historia.show { display: flex; }

        .modal-historia-conteudo {
            background: white;
            border-radius: var(--radius-xl);
            padding: 2.5rem;
            width: 100%;
            max-width: 560px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-xl);
            animation: scaleIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .modal-historia-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--bordo);
            margin-bottom: 1.75rem;
        }

        .form-label-premium {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--bordo);
            margin-bottom: 0.35rem;
            display: block;
        }

        .form-control-premium {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1.5px solid rgba(201, 149, 108, 0.3);
            border-radius: var(--radius-sm);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            color: var(--dark-2);
            background: var(--marfim);
            transition: border-color var(--transition-fast);
            outline: none;
        }

        .form-control-premium:focus {
            border-color: var(--rose-gold);
            background: white;
        }

        textarea.form-control-premium { resize: vertical; min-height: 100px; }

        /* ─── BOTÃO ADICIONAR ─── */
        .btn-adicionar-evento {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.85rem 2rem;
            background: linear-gradient(135deg, var(--bordo), var(--bordo-light));
            color: var(--marfim);
            font-family: 'Inter', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            border: none;
            border-radius: var(--radius-pill);
            cursor: pointer;
            text-decoration: none;
            transition: all var(--transition-fast);
            box-shadow: var(--shadow-md);
        }

        .btn-adicionar-evento:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            color: var(--marfim);
        }

        /* ─── RESPONSIVIDADE MOBILE ─── */
        @media (max-width: 700px) {
            .timeline-item,
            .timeline-item:nth-child(even) {
                justify-content: flex-end;
                padding-left: 5rem;
                padding-right: 0;
            }

            .timeline-dot {
                left: 28px;
                transform: translateX(-50%);
                width: 40px;
                height: 40px;
                font-size: 1.1rem;
            }

            .timeline-item:hover .timeline-dot { transform: translateX(-50%) scale(1.1); }

            .timeline-connector { display: none; }

            .timeline-card { max-width: 100%; }
        }
    </style>
</head>
<body>

<!-- Corações flutuantes -->
<div id="floating-hearts-container"></div>

