<!-- ═══ HERO ═══ -->
<header class="historia-hero">
    <div class="historia-hero-line"></div>
    <h1 class="historia-hero-titulo animate-fadeInUp">Nossa História</h1>
    <p class="historia-hero-sub animate-fadeInUp delay-2">
        <%= config.casal.nome1 %> &amp; <%= config.casal.nome2 %>
    </p>
    <div class="historia-hero-line" style="margin-top: 1.5rem;"></div>
    <p class="animate-fadeInUp delay-3" style="color: rgba(253,248,245,0.55); font-size: 0.85rem; letter-spacing: 0.15em; text-transform: uppercase; margin-top: 1rem;">
        Desde maio de 2025
    </p>

    <!-- Botão adicionar -->
    <div class="animate-fadeInUp delay-4" style="margin-top: 2.5rem;">
        <button class="btn-adicionar-evento" id="btnAbrirModal">
            <i class="fas fa-plus"></i> Adicionar Momento
        </button>
    </div>
</header>

<!-- ═══ TIMELINE ═══ -->
<main>
    <div class="timeline-wrapper" id="timeline">

        <% if (eventos && eventos.length > 0) { %>
            <% eventos.forEach(function(evento, index) { %>

            <div class="timeline-item reveal" id="evento-<%= evento.id %>">

                <!-- Ponto central -->
                <div class="timeline-dot <%= evento.cor === 'bordo' ? 'bordo-dot' : 'rose-dot' %>">
                    <%= evento.emoji || '❤️' %>
                </div>

                <!-- Linha de conexão -->
                <div class="timeline-connector"></div>

                <!-- Card -->
                <div class="timeline-card <%= evento.destaque ? 'destaque' : '' %>">

                    <% if (evento.foto) { %>
                        <img src="<%= evento.foto %>" alt="<%= evento.titulo %>" class="timeline-foto">
                    <% } else if (evento.destaque) { %>
                        <div class="timeline-foto-placeholder">
                            <span style="font-size: 2.5rem; opacity: 0.4;"><%= evento.emoji || '📸' %></span>
                            <span>Adicione uma foto editando este momento</span>
                        </div>
                    <% } %>

                    <div class="timeline-card-header">
                        <% if (evento.destaque) { %>
                            <div class="badge-destaque">✨ Momento especial</div>
                        <% } %>
                        <div class="timeline-data"><%= evento.dataFormatada %></div>
                        <div class="timeline-titulo"><%= evento.titulo %></div>
                    </div>

                    <div class="timeline-descricao">
                        <%= evento.descricao %>
                    </div>

                    <!-- Ações -->
                    <div class="timeline-acoes">
                        <button class="btn-acao btn-acao-editar" onclick="abrirModalEditar(<%= evento.id %>, this)"
                            data-id="<%= evento.id %>"
                            data-data="<%= evento.data %>"
                            data-dataformatada="<%= evento.dataFormatada %>"
                            data-titulo="<%= evento.titulo %>"
                            data-descricao="<%= evento.descricao.replace(/\"/g, '&quot;') %>"
                            data-emoji="<%= evento.emoji %>"
                            data-cor="<%= evento.cor %>"
                            data-foto="<%= evento.foto || '' %>"
                            data-destaque="<%= evento.destaque %>">
                            <i class="fas fa-pencil-alt"></i> Editar
                        </button>
                        <form action="/historia/deletar/<%= evento.id %>" method="POST" style="display:inline;"
                              onsubmit="return confirm('Excluir este momento da história?')">
                            <button type="submit" class="btn-acao btn-acao-deletar">
                                <i class="fas fa-trash"></i> Excluir
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <% }); %>
        <% } else { %>
            <div style="text-align: center; padding: 4rem 1rem; color: var(--cor-gray);">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📖</div>
                <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-style: italic;">
                    A história de vocês ainda vai ser escrita aqui...
                </p>
                <button class="btn-adicionar-evento" style="margin-top: 1.5rem;" onclick="document.getElementById('modalHistoria').classList.add('show')">
                    <i class="fas fa-plus"></i> Adicionar Primeiro Momento
                </button>
            </div>
        <% } %>

        <!-- FIM DA TIMELINE -->
        <% if (eventos && eventos.length > 0) { %>
        <div class="timeline-fim reveal">
            <div class="timeline-fim-circulo">❤️</div>
            <p class="timeline-fim-texto">
                E a história continua...<br>
                <span style="font-size: 0.85rem; opacity: 0.6;">Cada dia é um novo capítulo</span>
            </p>
        </div>
        <% } %>

    </div>
</main>

<!-- ═══ FOOTER ═══ -->
<footer>
    <p>Feito com <strong>❤️</strong> para <strong><%= config.casal.nome2 %></strong></p>
</footer>

<!-- ═══ MODAL DE FORMULÁRIO ═══ -->
<div class="modal-historia" id="modalHistoria">
    <div class="modal-historia-conteudo">
        <h2 class="modal-historia-titulo" id="modalHistoriaTitulo">Adicionar Momento</h2>

        <form id="formEvento" action="/historia/criar" method="POST">

            <div class="mb-3">
                <label class="form-label-premium">Emoji do momento</label>
                <input type="text" class="form-control-premium" name="emoji" id="campoEmoji"
                       placeholder="Ex: ❤️ 🎵 💋 ✨" maxlength="4">
            </div>

            <div class="mb-3">
                <label class="form-label-premium">Data exibida</label>
                <input type="text" class="form-control-premium" name="dataFormatada" id="campoDataFormatada"
                       placeholder="Ex: 15 de Maio, 2025 / Depois disso..." required>
            </div>

            <div class="mb-3">
                <label class="form-label-premium">Data (para ordenação)</label>
                <input type="date" class="form-control-premium" name="data" id="campoData">
            </div>

            <div class="mb-3">
                <label class="form-label-premium">Título</label>
                <input type="text" class="form-control-premium" name="titulo" id="campoTitulo"
                       placeholder="Ex: Primeiro 'Eu Te Amo'" required>
            </div>

            <div class="mb-3">
                <label class="form-label-premium">Descrição</label>
                <textarea class="form-control-premium" name="descricao" id="campoDescricao"
                          placeholder="Conte como foi esse momento especial..." required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label-premium">Link de Foto (URL)</label>
                <input type="text" class="form-control-premium" name="foto" id="campoFoto"
                       placeholder="https://... (opcional)">
            </div>

            <div class="mb-3">
                <label class="form-label-premium">Cor do ponto na timeline</label>
                <select class="form-control-premium" name="cor" id="campoCor">
                    <option value="bordo">Bordô (escuro)</option>
                    <option value="rose">Rose Gold (claro)</option>
                </select>
            </div>

            <div class="mb-4" style="display: flex; align-items: center; gap: 0.75rem;">
                <input type="checkbox" name="destaque" value="true" id="campoDestaque"
                       style="width: 18px; height: 18px; accent-color: var(--bordo);">
                <label for="campoDestaque" class="form-label-premium" style="margin: 0; cursor: pointer;">
                    ✨ Marcar como momento especial
                </label>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                <button type="button" class="btn-acao btn-acao-editar" id="btnCancelarModal"
                        style="padding: 0.65rem 1.5rem; font-size: 0.85rem;">
                    Cancelar
                </button>
                <button type="submit" class="btn-adicionar-evento" style="padding: 0.7rem 1.75rem;">
                    Salvar Momento
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ─── SCRIPTS ─── -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script src="/js/animations.js"></script>
<script>
    // ── Sidebar ───────────────────────────────────────────────────
    const sidebar        = document.getElementById('sidebar');
    const sidebarToggle  = document.getElementById('sidebarToggle');
    const sidebarClose   = document.getElementById('sidebarClose');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    function openSidebar()  { sidebar.classList.add('active'); sidebarOverlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
    function closeSidebar() { sidebar.classList.remove('active'); sidebarOverlay.classList.remove('active'); document.body.style.overflow = ''; }

    sidebarToggle.addEventListener('click', openSidebar);
    sidebarClose.addEventListener('click', closeSidebar);
    sidebarOverlay.addEventListener('click', closeSidebar);
    document.querySelectorAll('.sidebar-menu a').forEach(l => l.addEventListener('click', closeSidebar));

    // ── Modal ─────────────────────────────────────────────────────
    const modalHistoria   = document.getElementById('modalHistoria');
    const formEvento      = document.getElementById('formEvento');
    const modalTitulo     = document.getElementById('modalHistoriaTitulo');
    const btnAbrirModal   = document.getElementById('btnAbrirModal');
    const btnCancelarModal = document.getElementById('btnCancelarModal');

    function abrirModalNovo() {
        modalTitulo.textContent = 'Adicionar Momento';
        formEvento.action = '/historia/criar';
        formEvento.reset();
        modalHistoria.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function fecharModal() {
        modalHistoria.classList.remove('show');
        document.body.style.overflow = '';
    }

    btnAbrirModal && btnAbrirModal.addEventListener('click', abrirModalNovo);
    btnCancelarModal.addEventListener('click', fecharModal);

    modalHistoria.addEventListener('click', (e) => {
        if (e.target === modalHistoria) fecharModal();
    });

    // ── Abrir modal de editar ────────────────────────────────────
    window.abrirModalEditar = function(id, btn) {
        const d = btn.dataset;

        modalTitulo.textContent = 'Editar Momento';
        formEvento.action = `/historia/editar/${id}`;

        document.getElementById('campoEmoji').value         = d.emoji         || '';
        document.getElementById('campoDataFormatada').value = d.dataformatada  || '';
        document.getElementById('campoData').value          = d.data           || '';
        document.getElementById('campoTitulo').value        = d.titulo         || '';
        document.getElementById('campoDescricao').value     = d.descricao      || '';
        document.getElementById('campoFoto').value          = d.foto           || '';
        document.getElementById('campoCor').value           = d.cor            || 'bordo';
        document.getElementById('campoDestaque').checked    = d.destaque === 'true';

        modalHistoria.classList.add('show');
        document.body.style.overflow = 'hidden';
    };
</script>
</body>
</html>
