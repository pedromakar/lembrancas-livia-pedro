<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --cor-principal: #5A1C35;
            --cor-secundaria: #A35F74;
            --cor-light: #fff8f4;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--cor-light) 0%, #fff2ee 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .erro-container {
            text-align: center;
            background: white;
            padding: 3rem 2rem;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(90,28,53,0.18);
        }

        .erro-icon {
            font-size: 5rem;
            color: #8B3E2F;
            margin-bottom: 1rem;
        }

        h1 {
            color: var(--cor-principal);
            font-weight: bold;
            margin-bottom: 1rem;
        }

        p {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

        .btn-voltar {
            background: linear-gradient(90deg, var(--cor-principal), var(--cor-secundaria));
            border: none;
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
        }

        .btn-voltar:hover {
            transform: scale(1.05);
            color: white;
        }

        @media (max-width: 768px) {
            .erro-container {
                padding: 2rem 1rem;
            }

            .erro-icon {
                font-size: 3rem;
            }
        }
    </style>
</head>
<body>
    <div class="erro-container">
        <div class="erro-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h1>Oops! Algo deu errado</h1>
        <p><%= mensagem %></p>
        <a href="/" class="btn-voltar">
            <i class="fas fa-home"></i> Voltar para o início
        </a>
    </div>
</body>
</html>
