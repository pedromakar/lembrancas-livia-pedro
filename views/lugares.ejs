<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nossos Lugares — Nosso Lugar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet.js (mapa sem chave de API) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: var(--marfim); }

        .lugares-hero {
            background: linear-gradient(160deg, var(--dark) 0%, var(--bordo-dark) 100%);
            color: var(--marfim);
            padding: 5rem 1.5rem 4rem;
            text-align: center;
        }
        .hero-line { width:60px; height:1px; background:linear-gradient(90deg,transparent,var(--rose-gold),transparent); margin:0 auto 1.5rem; }
        .lugares-hero h1 { font-family:'Cormorant Garamond',serif; font-size:clamp(2.8rem,7vw,4.5rem); font-weight:600; }
        .lugares-hero p { font-family:'Cormorant Garamond',serif; font-size:1.1rem; font-style:italic; color:var(--rose-gold); margin-top:.5rem; }

        /* Layout: mapa + lista lado a lado */
        .lugares-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 0;
            min-height: 600px;
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1.5rem 4rem;
        }
        @media (max-width:900px) { .lugares-layout { grid-template-columns:1fr; } }

        /* Mapa */
        #map {
            border-radius: var(--radius-lg) 0 0 var(--radius-lg);
            height: 600px;
            box-shadow: var(--shadow-md);
            z-index: 1;
        }
        @media (max-width:900px) { #map { border-radius:var(--radius-lg); height:380px; } }

        /* Lista de lugares */
        .lugares-lista {
            background: white;
            border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
            box-shadow: var(--shadow-md);
            overflow-y: auto;
            max-height: 600px;
            border-left: 1px solid rgba(201,149,108,0.12);
        }
        @media (max-width:900px) { .lugares-lista { border-radius:var(--radius-lg); max-height:none; border-left:none; } }

        .lista-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(201,149,108,0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .lista-header h3 { font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:600; color:var(--bordo); margin:0; }

        .btn-add-lugar {
            display:inline-flex; align-items:center; gap:6px; padding:.45rem 1rem;
            background:linear-gradient(135deg,var(--bordo),var(--bordo-light));
            color:var(--marfim); border:none; border-radius:var(--radius-pill);
            font-family:'Inter',sans-serif; font-size:.78rem; font-weight:600;
            cursor:pointer; transition:all var(--transition-fast);
        }
        .btn-add-lugar:hover { transform:translateY(-1px); box-shadow:var(--shadow-md); }

        .lugar-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(201,149,108,0.08);
            cursor: pointer;
            transition: background var(--transition-fast);
        }
        .lugar-item:hover { background: rgba(201,149,108,0.05); }
        .lugar-item.ativo { background: rgba(90,28,53,0.06); border-left: 3px solid var(--bordo); }

        .lugar-emoji { font-size: 1.8rem; flex-shrink: 0; line-height: 1; margin-top: 2px; }
        .lugar-info { flex: 1; min-width: 0; }
        .lugar-nome { font-family:'Cormorant Garamond',serif; font-size:1.1rem; font-weight:600; color:var(--bordo); }
        .lugar-data { font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--rose-gold-dark); margin:.2rem 0; }
        .lugar-desc { font-size:.82rem; color:var(--dark-3); line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }

        .lugar-acoes { display:flex; gap:.3rem; flex-shrink:0; }
        .btn-acao-xxs { padding:.2rem .5rem; font-size:.7rem; border-radius:var(--radius-sm); border:1px solid; background:transparent; cursor:pointer; transition:all var(--transition-fast); }
        .btn-edit-xxs { border-color:rgba(90,28,53,.2); color:var(--bordo); }
        .btn-edit-xxs:hover { background:var(--bordo); color:var(--marfim); }
        .btn-del-xxs { border-color:rgba(220,80,80,.2); color:#c0392b; }
        .btn-del-xxs:hover { background:#c0392b; color:white; }

        /* Custom Leaflet marker */
        .custom-marker {
            background: var(--bordo);
            border: 3px solid white;
            border-radius: 50% 50% 50% 0;
            width: 30px; height: 30px;
            transform: rotate(-45deg);
            display: flex; align-items: center; justify-content: center;
            box-shadow: var(--shadow-md);
        }

        /* Modal */
        .modal-lugar { display:none; position:fixed; inset:0; background:rgba(20,8,14,.82); backdrop-filter:blur(10px); z-index:var(--z-modal); align-items:center; justify-content:center; padding:1rem; }
        .modal-lugar.show { display:flex; }
        .modal-lugar-c { background:white; border-radius:var(--radius-xl); padding:2.5rem; width:100%; max-width:520px; max-height:90vh; overflow-y:auto; box-shadow:var(--shadow-xl); animation:scaleIn .35s cubic-bezier(.16,1,.3,1); }
        .modal-lugar-titulo { font-family:'Cormorant Garamond',serif; font-size:1.8rem; font-weight:600; color:var(--bordo); margin-bottom:1.75rem; }
        .flbl { font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--bordo); margin-bottom:.3rem; display:block; }
        .fctrl { width:100%; padding:.72rem 1rem; border:1.5px solid rgba(201,149,108,.3); border-radius:var(--radius-sm); font-family:'Inter',sans-serif; font-size:.88rem; color:var(--dark-2); background:var(--marfim); transition:border-color var(--transition-fast); outline:none; }
        .fctrl:focus { border-color:var(--rose-gold); background:white; }
        textarea.fctrl { resize:vertical; min-height:80px; }
    </style>
</head>
<body>
<div id="floating-hearts-container"></div>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div><div class="sidebar-title">Nosso Lugar</div><div class="sidebar-sub"><%= config.casal.nome1 %> & <%= config.casal.nome2 %></div></div>
        <button class="btn-close btn-close-white" id="sidebarClose"></button>
    </div>
    <ul class="sidebar-menu">
        <li><a href="/"><span class="menu-icon">🏠</span> Início</a></li>
        <li><a href="/historia"><span class="menu-icon">❤️</span> Nossa História</a></li>
        <li><a href="/lembrancas"><span class="menu-icon">📸</span> Lembranças</a></li>
        <li><a href="/cartas"><span class="menu-icon">💌</span> Cartas</a></li>
        <li><a href="/playlist"><span class="menu-icon">🎵</span> Playlist</a></li>
        <li><a href="/lugares" class="active"><span class="menu-icon">🗺️</span> Lugares</a></li>
        <li><a href="/estatisticas"><span class="menu-icon">📊</span> Estatísticas</a></li>
    </ul>
</div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid px-4">
        <button class="btn btn-link text-white p-2 me-2" id="sidebarToggle"><i class="fas fa-bars"></i></button>
        <a class="navbar-brand" href="/">❤️ Nosso Lugar</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Início</a></li>
                    <li class="nav-item"><a class="nav-link" href="/cartas"><i class="fas fa-envelope me-1"></i>Cartas</a></li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-highlight" href="/jogos" style="background: rgba(255, 255, 255, 0.25); border-radius: 20px; padding: 5px 15px !important; font-weight: bold; border: 1px solid rgba(255, 255, 255, 0.4); box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                            <i class="fas fa-gamepad"></i> 🎮 Jogos
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/lembrancas"><i class="fas fa-images me-1"></i>Lembranças</a></li>
                    <li class="nav-item"><a class="nav-link" href="/historia"><i class="fas fa-book-heart me-1"></i>História</a></li>
                    <li class="nav-item"><a class="nav-link" href="/playlist"><i class="fas fa-music me-1"></i>Playlist</a></li>
                    <li class="nav-item"><a class="nav-link" href="/lugares"><i class="fas fa-map-marker-alt me-1"></i>Lugares</a></li>
                    <li class="nav-item"><a class="nav-link" href="/estatisticas"><i class="fas fa-chart-pie me-1"></i>Estatísticas</a></li>
                </ul>
        </div>
    </div>
</nav>

<header class="lugares-hero">
    <div class="hero-line"></div>
    <h1 class="animate-fadeInUp">Nossos Lugares</h1>
    <p class="animate-fadeInUp delay-2">Os lugares que guardam as nossas memórias</p>
    <div class="hero-line" style="margin-top:1.5rem;"></div>
</header>

<!-- LAYOUT: MAPA + LISTA -->
<div class="lugares-layout">
    <!-- Mapa -->
    <div id="map"></div>

    <!-- Lista -->
    <div class="lugares-lista">
        <div class="lista-header">
            <h3>📍 <%= lugares.length %> lugares</h3>
            <button class="btn-add-lugar" id="btnAddLugar"><i class="fas fa-plus"></i> Adicionar</button>
        </div>

        <% if (lugares && lugares.length > 0) { %>
            <% lugares.forEach(function(l) { %>
            <div class="lugar-item reveal" id="lugar-item-<%= l.id %>" onclick="focarNoMapa(<%= l.lat %>, <%= l.lng %>, <%= l.id %>)">
                <div class="lugar-emoji"><%= l.emoji || '📍' %></div>
                <div class="lugar-info">
                    <div class="lugar-nome"><%= l.nome %></div>
                    <div class="lugar-data"><%= l.data %></div>
                    <div class="lugar-desc"><%= l.descricao %></div>
                </div>
                <div class="lugar-acoes" onclick="event.stopPropagation()">
                    <button class="btn-acao-xxs btn-edit-xxs" onclick="abrirModalEditar(<%= l.id %>, this)"
                        data-id="<%= l.id %>"
                        data-nome="<%= l.nome %>"
                        data-descricao="<%= l.descricao.replace(/\"/g,'&quot;') %>"
                        data-emoji="<%= l.emoji || '📍' %>"
                        data-lat="<%= l.lat %>"
                        data-lng="<%= l.lng %>"
                        data-data="<%= l.data || '' %>"
                        data-cor="<%= l.cor || '#5A1C35' %>"
                        data-foto="<%= l.foto || '' %>"><i class="fas fa-pencil-alt"></i></button>
                    <form action="/lugares/deletar/<%= l.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Excluir este lugar?')">
                        <button type="submit" class="btn-acao-xxs btn-del-xxs"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            <% }) %>
        <% } else { %>
            <div style="text-align:center; padding:3rem 1rem; color:var(--cor-gray);">
                <div style="font-size:2.5rem; margin-bottom:.75rem;">🗺️</div>
                <p style="font-family:'Cormorant Garamond',serif; font-size:1.1rem; font-style:italic;">Adicione os lugares especiais de vocês</p>
            </div>
        <% } %>
    </div>
</div>

<footer><p>Feito com <strong>❤️</strong> para <strong><%= config.casal.nome2 %></strong></p></footer>

<!-- MODAL -->
<div class="modal-lugar" id="modalLugar">
    <div class="modal-lugar-c">
        <h2 class="modal-lugar-titulo" id="modalLugarTitulo">Adicionar Lugar</h2>
        <form id="formLugar" action="/lugares/criar" method="POST">
            <div class="mb-3"><label class="flbl">Emoji</label><input type="text" class="fctrl" name="emoji" id="lEmoji" placeholder="📍" maxlength="4"></div>
            <div class="mb-3"><label class="flbl">Nome do Lugar</label><input type="text" class="fctrl" name="nome" id="lNome" required placeholder="Ex: IFC — Instituto Federal"></div>
            <div class="mb-3"><label class="flbl">Descrição</label><textarea class="fctrl" name="descricao" id="lDesc" placeholder="Por que este lugar é especial?"></textarea></div>
            <div class="row mb-3">
                <div class="col-sm-6"><label class="flbl">Latitude</label><input type="text" class="fctrl" name="lat" id="lLat" placeholder="Ex: -26.91"></div>
                <div class="col-sm-6"><label class="flbl">Longitude</label><input type="text" class="fctrl" name="lng" id="lLng" placeholder="Ex: -49.06"></div>
            </div>
            <p style="font-size:.75rem; color:var(--cor-gray); margin-top:-.5rem; margin-bottom:1rem;">💡 Clique no mapa para preencher as coordenadas automaticamente</p>
            <div class="mb-3"><label class="flbl">Quando?</label><input type="text" class="fctrl" name="data" id="lData" placeholder="Ex: Maio de 2025"></div>
            <div class="mb-3"><label class="flbl">Cor do Marcador</label><input type="color" class="fctrl" name="cor" id="lCor" value="#5A1C35" style="height:44px; padding:.3rem;"></div>
            <div class="mb-4"><label class="flbl">Link de Foto (URL)</label><input type="text" class="fctrl" name="foto" id="lFoto" placeholder="https://... (opcional)"></div>
            <div style="display:flex; gap:.75rem; justify-content:flex-end;">
                <button type="button" id="btnCancelarLugar" style="padding:.6rem 1.25rem; font-size:.85rem; border:1px solid rgba(90,28,53,.25); color:var(--bordo); background:none; border-radius:var(--radius-sm); cursor:pointer;">Cancelar</button>
                <button type="submit" class="btn-add-lugar" style="padding:.7rem 1.75rem; font-size:.9rem;">Salvar Lugar</button>
            </div>
        </form>
    </div>
</div>

<script>
const lugaresData = <%- JSON.stringify(lugares) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script src="/js/animations.js"></script>
<script>
    // Sidebar
    const sidebar=document.getElementById('sidebar'),sidebarToggle=document.getElementById('sidebarToggle'),sidebarClose=document.getElementById('sidebarClose'),sidebarOverlay=document.getElementById('sidebarOverlay');
    const openSb=()=>{sidebar.classList.add('active');sidebarOverlay.classList.add('active');document.body.style.overflow='hidden';};
    const closeSb=()=>{sidebar.classList.remove('active');sidebarOverlay.classList.remove('active');document.body.style.overflow='';};
    sidebarToggle.addEventListener('click',openSb);sidebarClose.addEventListener('click',closeSb);sidebarOverlay.addEventListener('click',closeSb);
    document.querySelectorAll('.sidebar-menu a').forEach(l=>l.addEventListener('click',closeSb));

    // ── MAPA LEAFLET ───────────────────────────────────────────
    const centro = lugaresData.length > 0
        ? [lugaresData[0].lat, lugaresData[0].lng]
        : [-26.91, -49.07];

    const map = L.map('map', { zoomControl: true }).setView(centro, 14);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19
    }).addTo(map);

    const markers = {};

    function criarIcone(emoji, cor) {
        return L.divIcon({
            html: `<div style="background:${cor||'#5A1C35'};width:38px;height:38px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 4px 12px rgba(0,0,0,.3);">
                       <span style="transform:rotate(45deg);font-size:1.1rem;">${emoji||'📍'}</span>
                   </div>`,
            className: '',
            iconSize: [38, 38],
            iconAnchor: [19, 38],
            popupAnchor: [0, -42]
        });
    }

    lugaresData.forEach(l => {
        if (!l.lat || !l.lng) return;
        const marker = L.marker([l.lat, l.lng], { icon: criarIcone(l.emoji, l.cor) })
            .addTo(map)
            .bindPopup(`
                <div style="font-family:'Inter',sans-serif; min-width:200px;">
                    <div style="font-size:1.5rem; text-align:center; margin-bottom:.5rem;">${l.emoji||'📍'}</div>
                    <strong style="color:#5A1C35; font-family:'Cormorant Garamond',serif; font-size:1.1rem;">${l.nome}</strong>
                    <p style="font-size:.8rem; color:#76656D; margin:.4rem 0;">${l.data||''}</p>
                    <p style="font-size:.82rem; color:#3D2A32; line-height:1.5;">${l.descricao}</p>
                    ${l.foto ? `<img src="${l.foto}" style="width:100%;border-radius:8px;margin-top:.5rem;" alt="${l.nome}">` : ''}
                </div>
            `, { maxWidth: 280 });
        markers[l.id] = marker;
    });

    window.focarNoMapa = function(lat, lng, id) {
        map.flyTo([lat, lng], 16, { duration: 1.2 });
        if (markers[id]) markers[id].openPopup();
        document.querySelectorAll('.lugar-item').forEach(el => el.classList.remove('ativo'));
        const el = document.getElementById(`lugar-item-${id}`);
        if (el) el.classList.add('ativo');
    };

    // Clique no mapa → preenche coordenadas no modal
    map.on('click', function(e) {
        document.getElementById('lLat').value = e.latlng.lat.toFixed(6);
        document.getElementById('lLng').value = e.latlng.lng.toFixed(6);
    });

    // ── Modal ────────────────────────────────────────────────────
    const modalLugar = document.getElementById('modalLugar');
    const formLugar  = document.getElementById('formLugar');
    const openL  = () => { formLugar.reset(); document.getElementById('modalLugarTitulo').textContent='Adicionar Lugar'; formLugar.action='/lugares/criar'; modalLugar.classList.add('show'); document.body.style.overflow='hidden'; };
    const closeL = () => { modalLugar.classList.remove('show'); document.body.style.overflow=''; };
    document.getElementById('btnAddLugar').addEventListener('click', openL);
    document.getElementById('btnCancelarLugar').addEventListener('click', closeL);
    modalLugar.addEventListener('click', e => { if(e.target===modalLugar) closeL(); });

    window.abrirModalEditar = function(id, btn) {
        const d = btn.dataset;
        document.getElementById('modalLugarTitulo').textContent = 'Editar Lugar';
        formLugar.action = `/lugares/editar/${id}`;
        document.getElementById('lEmoji').value = d.emoji || '';
        document.getElementById('lNome').value  = d.nome  || '';
        document.getElementById('lDesc').value  = d.descricao || '';
        document.getElementById('lLat').value   = d.lat   || '';
        document.getElementById('lLng').value   = d.lng   || '';
        document.getElementById('lData').value  = d.data  || '';
        document.getElementById('lCor').value   = d.cor   || '#5A1C35';
        document.getElementById('lFoto').value  = d.foto  || '';
        modalLugar.classList.add('show');
        document.body.style.overflow='hidden';
    };
</script>
</body>
</html>
