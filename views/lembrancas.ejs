</nav>

<!-- ═══ HERO ═══ -->
<header class="lembrancas-hero">
    <div class="hero-line"></div>
    <h1 class="animate-fadeInUp">Lembranças</h1>
    <p class="animate-fadeInUp delay-2">Os momentos que a gente nunca quer esquecer</p>
    <div class="hero-line" style="margin-top: 1.5rem;"></div>
</header>

<!-- ═══ TOOLBAR ═══ -->
<div class="lembrancas-toolbar">
    <!-- Pesquisa -->
    <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="buscaInput" placeholder="Pesquisar lembranças..." autocomplete="off">
    </div>

    <!-- Filtros -->
    <div class="filtros">
        <button class="filtro-btn ativo" data-filtro="todos">Todas</button>
        <button class="filtro-btn" data-filtro="favoritos">❤️ Favoritas</button>
        <button class="filtro-btn" data-filtro="IFC">IFC</button>
        <button class="filtro-btn" data-filtro="casa">Em Casa</button>
    </div>

    <!-- Botão surpresa -->
    <button class="btn-surpresa" id="btn-surpreenda" style="padding: 0.6rem 1.5rem; font-size: 0.85rem; gap: 6px;">
        ✨ Surpreenda-me
    </button>
</div>

<!-- ═══ STATS ═══ -->
<div class="lembrancas-stats">
    <span class="stat-badge">📸 <%= lembrancas.length %> lembranças</span>
    <span class="stat-badge">❤️ <%= lembrancas.filter(l => l.favorito).length %> favoritas</span>
    <span id="stat-visiveis" class="stat-badge" style="display: none;"></span>
</div>

<!-- ═══ GRID MASONRY ═══ -->
<div class="lembrancas-grid" id="lembrancasGrid">

    <% if (lembrancas && lembrancas.length > 0) { %>
        <% lembrancas.forEach(function(l, idx) { %>

        <div class="lembranca-card reveal"
             id="lembranca-<%= l.id %>"
             data-titulo="<%= l.titulo.toLowerCase() %>"
             data-descricao="<%= l.descricao.toLowerCase() %>"
             data-tags="<%= (l.tags || '').toLowerCase() %>"
             data-local="<%= (l.local || '').toLowerCase() %>"
             data-favorito="<%= l.favorito ? 'true' : 'false' %>">

            <!-- Foto ou emoji placeholder -->
            <% if (l.imagem) { %>
                <img src="<%= l.imagem %>" alt="<%= l.titulo %>" class="lembranca-foto">
            <% } else { %>
                <div class="lembranca-foto-placeholder"><%= l.icone || '📸' %></div>
            <% } %>

            <!-- Corpo -->
            <div class="lembranca-corpo">
                <div class="lembranca-meta">
                    <span class="lembranca-data"><%= l.dataFormatada || l.data %></span>
                    <% if (l.local) { %>
                    <span class="lembranca-local"><i class="fas fa-map-marker-alt" style="font-size: 0.65rem;"></i> <%= l.local %></span>
                    <% } %>
                </div>
                <div class="lembranca-titulo"><%= l.titulo %></div>
                <div class="lembranca-descricao" id="desc-<%= l.id %>"><%= l.descricao %></div>

                <!-- Tags -->
                <% if (l.tags) { %>
                <div class="lembranca-tags">
                    <% l.tags.split(',').forEach(function(tag) { %>
                        <% if (tag.trim()) { %>
                        <span class="tag" onclick="filtrarPorTag('<%= tag.trim() %>')">#<%= tag.trim() %></span>
                        <% } %>
                    <% }) %>
                </div>
                <% } %>
            </div>

            <!-- Ações -->
            <div class="lembranca-acoes">
                <!-- Favoritar -->
                <button class="btn-favoritar <%= l.favorito ? 'favoritado' : '' %>"
                        id="fav-<%= l.id %>"
                        onclick="toggleFavorito(<%= l.id %>, this)"
                        title="<%= l.favorito ? 'Desfavoritar' : 'Favoritar' %>">
                    <%= l.favorito ? '❤️' : '🤍' %>
                </button>

                <!-- Expandir texto -->
                <button class="btn-expandir" onclick="toggleExpandir(<%= l.id %>, this)">Ver mais</button>

                <!-- Editar -->
                <button class="btn-acao-sm btn-editar-sm ms-auto" onclick="abrirModalEditar(<%= l.id %>, this)"
                    data-id="<%= l.id %>"
                    data-titulo="<%= l.titulo %>"
                    data-data="<%= l.data %>"
                    data-dataformatada="<%= l.dataFormatada || '' %>"
                    data-descricao="<%= l.descricao.replace(/\"/g, '&quot;') %>"
                    data-icone="<%= l.icone || '📸' %>"
                    data-tags="<%= l.tags || '' %>"
                    data-imagem="<%= l.imagem || '' %>"
                    data-local="<%= l.local || '' %>"
                    data-favorito="<%= l.favorito %>">
                    <i class="fas fa-pencil-alt"></i>
                </button>

                <!-- Deletar -->
                <form action="/lembrancas/deletar/<%= l.id %>" method="POST" style="display:inline;"
                      onsubmit="return confirm('Excluir esta lembrança?')">
                    <button type="submit" class="btn-acao-sm btn-deletar-sm">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </div>
        </div>

        <% }) %>
    <% } else { %>
        <div class="empty-state">
            <div style="font-size: 3.5rem; margin-bottom: 1rem;">📸</div>
            <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-style: italic; color: var(--cor-gray);">
                As primeiras lembranças ainda vão ser criadas...
            </p>
        </div>
    <% } %>

</div>

<!-- ═══ FOOTER ═══ -->
<footer>
    <p>Feito com <strong>❤️</strong> para <strong><%= config.casal.nome2 %></strong></p>
</footer>

<!-- ═══ FAB ADICIONAR ═══ -->
<button class="btn-adicionar-fab" id="btnFab" title="Adicionar Lembrança">+</button>

<!-- Toast -->
<div class="toast-notif" id="toastNotif"></div>

<!-- ═══ MODAL FORMULÁRIO ═══ -->
<div class="modal-lem" id="modalLem">
    <div class="modal-lem-conteudo">
        <h2 class="modal-lem-titulo" id="modalLemTitulo">Nova Lembrança</h2>

        <form id="formLem" action="/lembrancas/criar" method="POST">
            <div class="mb-3">
                <label class="form-label-p">Emoji / Ícone</label>
                <input type="text" class="form-ctrl" name="icone" id="campoIcone" placeholder="📸" maxlength="4">
            </div>
            <div class="mb-3">
                <label class="form-label-p">Título</label>
                <input type="text" class="form-ctrl" name="titulo" id="campoTitulo" placeholder="Ex: Primeiro Selinho" required>
            </div>
            <div class="row mb-3">
                <div class="col-sm-6">
                    <label class="form-label-p">Data exibida</label>
                    <input type="text" class="form-ctrl" name="dataFormatada" id="campoDataFormatada" placeholder="Ex: Junho de 2025">
                </div>
                <div class="col-sm-6" style="margin-top: 0.25rem;">
                    <label class="form-label-p">Data (para ordenação)</label>
                    <input type="date" class="form-ctrl" name="data" id="campoData">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label-p">Descrição</label>
                <textarea class="form-ctrl" name="descricao" id="campoDescricao" placeholder="Conta como foi..." required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label-p">Local</label>
                <input type="text" class="form-ctrl" name="local" id="campoLocal" placeholder="Ex: IFC, Minha casa...">
            </div>
            <div class="mb-3">
                <label class="form-label-p">Tags (separadas por vírgula)</label>
                <input type="text" class="form-ctrl" name="tags" id="campoTags" placeholder="Ex: especial, escola, amor">
            </div>
            <div class="mb-3">
                <label class="form-label-p">Link da Foto (URL)</label>
                <input type="text" class="form-ctrl" name="imagem" id="campoImagem" placeholder="https://... (opcional)">
            </div>
            <div class="mb-4" style="display: flex; align-items: center; gap: 0.75rem;">
                <input type="checkbox" name="favorito" value="true" id="campoFavorito"
                       style="width: 18px; height: 18px; accent-color: var(--bordo);">
                <label for="campoFavorito" class="form-label-p" style="margin: 0; cursor: pointer;">❤️ Marcar como favorita</label>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                <button type="button" class="btn-acao-sm btn-editar-sm" id="btnCancelarLem"
                        style="padding: 0.65rem 1.5rem; font-size: 0.85rem;">Cancelar</button>
                <button type="submit" class="btn-adicionar-evento" style="padding: 0.7rem 1.75rem; font-size: 0.9rem;">
                    Salvar Lembrança
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ─── SCRIPTS ─── -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script src="/js/animations.js"></script>
<script>
    // ── Sidebar ─────────────────────────────────────────────────
    const sidebar        = document.getElementById('sidebar');
    const sidebarToggle  = document.getElementById('sidebarToggle');
    const sidebarClose   = document.getElementById('sidebarClose');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    const openSb  = () => { sidebar.classList.add('active'); sidebarOverlay.classList.add('active'); document.body.style.overflow = 'hidden'; };
    const closeSb = () => { sidebar.classList.remove('active'); sidebarOverlay.classList.remove('active'); document.body.style.overflow = ''; };
    sidebarToggle.addEventListener('click', openSb);
    sidebarClose.addEventListener('click', closeSb);
    sidebarOverlay.addEventListener('click', closeSb);
    document.querySelectorAll('.sidebar-menu a').forEach(l => l.addEventListener('click', closeSb));

    // ── Toast ────────────────────────────────────────────────────
    function mostrarToast(msg) {
        const t = document.getElementById('toastNotif');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2500);
    }

    // ── Favoritar ────────────────────────────────────────────────
    async function toggleFavorito(id, btn) {
        btn.style.transform = 'scale(1.4)';
        setTimeout(() => btn.style.transform = '', 250);
        try {
            const r = await fetch(`/api/lembrancas/favoritar/${id}`, { method: 'POST' });
            const data = await r.json();
            const card = document.getElementById(`lembranca-${id}`);
            if (data.favorito) {
                btn.textContent = '❤️';
                btn.classList.add('favoritado');
                card.dataset.favorito = 'true';
                mostrarToast('Adicionada aos favoritos ❤️');
            } else {
                btn.textContent = '🤍';
                btn.classList.remove('favoritado');
                card.dataset.favorito = 'false';
                mostrarToast('Removida dos favoritos');
            }
        } catch (_) {
            mostrarToast('Erro ao favoritar 😕');
        }
    }

    // ── Expandir texto ───────────────────────────────────────────
    function toggleExpandir(id, btn) {
        const desc = document.getElementById(`desc-${id}`);
        if (desc.classList.contains('expandida')) {
            desc.classList.remove('expandida');
            btn.textContent = 'Ver mais';
        } else {
            desc.classList.add('expandida');
            btn.textContent = 'Ver menos';
        }
    }

    // ── Pesquisa + Filtros ───────────────────────────────────────
    const cards    = document.querySelectorAll('.lembranca-card');
    const busca    = document.getElementById('buscaInput');
    const filtros  = document.querySelectorAll('.filtro-btn');
    const statVis  = document.getElementById('stat-visiveis');
    let filtroAtual = 'todos';
    let termoBusca  = '';

    function aplicarFiltros() {
        let visiveis = 0;
        cards.forEach(card => {
            const titulo    = card.dataset.titulo    || '';
            const descricao = card.dataset.descricao || '';
            const tags      = card.dataset.tags      || '';
            const local     = card.dataset.local     || '';
            const favorito  = card.dataset.favorito  === 'true';

            const passaBusca = !termoBusca ||
                titulo.includes(termoBusca) ||
                descricao.includes(termoBusca) ||
                tags.includes(termoBusca) ||
                local.includes(termoBusca);

            let passaFiltro = true;
            if (filtroAtual === 'favoritos') passaFiltro = favorito;
            else if (filtroAtual !== 'todos') passaFiltro = local.includes(filtroAtual.toLowerCase()) || tags.includes(filtroAtual.toLowerCase());

            if (passaBusca && passaFiltro) {
                card.classList.remove('oculto');
                visiveis++;
            } else {
                card.classList.add('oculto');
            }
        });

        if (termoBusca || filtroAtual !== 'todos') {
            statVis.textContent = `${visiveis} resultado${visiveis !== 1 ? 's' : ''}`;
            statVis.style.display = 'inline-flex';
        } else {
            statVis.style.display = 'none';
        }
    }

    busca.addEventListener('input', () => {
        termoBusca = busca.value.toLowerCase().trim();
        aplicarFiltros();
    });

    filtros.forEach(btn => {
        btn.addEventListener('click', () => {
            filtros.forEach(b => b.classList.remove('ativo'));
            btn.classList.add('ativo');
            filtroAtual = btn.dataset.filtro;
            aplicarFiltros();
        });
    });

    window.filtrarPorTag = function(tag) {
        busca.value = tag;
        termoBusca = tag.toLowerCase();
        filtros.forEach(b => { b.classList.remove('ativo'); if (b.dataset.filtro === 'todos') b.classList.add('ativo'); });
        filtroAtual = 'todos';
        aplicarFiltros();
        busca.focus();
    };

    // ── Modal Formulário ─────────────────────────────────────────
    const modalLem   = document.getElementById('modalLem');
    const formLem    = document.getElementById('formLem');
    const modalTitulo = document.getElementById('modalLemTitulo');
    const btnFab     = document.getElementById('btnFab');
    const btnCancelar = document.getElementById('btnCancelarLem');

    function fecharModal() {
        modalLem.classList.remove('show');
        document.body.style.overflow = '';
    }

    btnFab.addEventListener('click', () => {
        modalTitulo.textContent = 'Nova Lembrança';
        formLem.action = '/lembrancas/criar';
        formLem.reset();
        modalLem.classList.add('show');
        document.body.style.overflow = 'hidden';
    });

    btnCancelar.addEventListener('click', fecharModal);
    modalLem.addEventListener('click', e => { if (e.target === modalLem) fecharModal(); });

    window.abrirModalEditar = function(id, btn) {
        const d = btn.dataset;
        modalTitulo.textContent = 'Editar Lembrança';
        formLem.action = `/lembrancas/editar/${id}`;
        document.getElementById('campoIcone').value         = d.icone         || '';
        document.getElementById('campoTitulo').value        = d.titulo         || '';
        document.getElementById('campoDataFormatada').value = d.dataformatada  || '';
        document.getElementById('campoData').value          = d.data           || '';
        document.getElementById('campoDescricao').value     = d.descricao      || '';
        document.getElementById('campoLocal').value         = d.local          || '';
        document.getElementById('campoTags').value          = d.tags           || '';
        document.getElementById('campoImagem').value        = d.imagem         || '';
        document.getElementById('campoFavorito').checked    = d.favorito === 'true';
        modalLem.classList.add('show');
        document.body.style.overflow = 'hidden';
    };

    // ── Botão Surpreenda ────────────────────────────────────────
    document.getElementById('btn-surpreenda').addEventListener('click', async (e) => {
        e.preventDefault();
        const cardsVisiveis = [...cards].filter(c => !c.classList.contains('oculto'));
        if (!cardsVisiveis.length) return;
        const card = cardsVisiveis[Math.floor(Math.random() * cardsVisiveis.length)];
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.style.transition = 'box-shadow 0.3s';
        card.style.boxShadow = '0 0 0 4px var(--rose-gold)';
        setTimeout(() => card.style.boxShadow = '', 2000);
        mostrarToast('✨ Aqui está uma memória especial!');
    });
</script>
</body>
</html>