<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Lembranças — <%= config.casal.nome1 %> & <%= config.casal.nome2 %>">
    <title>Lembranças — Nosso Lugar</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body { background: var(--marfim); }

        /* ─── HERO ─── */
        .lembrancas-hero {
            background: linear-gradient(160deg, var(--dark) 0%, var(--dark-2) 50%, #2a0d1a 100%);
            color: var(--marfim);
            padding: 5rem 1.5rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .lembrancas-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 30% 50%, rgba(201, 149, 108, 0.1) 0%, transparent 60%);
        }

        .hero-line {
            width: 60px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--rose-gold), transparent);
            margin: 0 auto 1.5rem;
        }

        .lembrancas-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.8rem, 7vw, 4.5rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            position: relative;
            color: var(--marfim);
        }

        .lembrancas-hero p {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-style: italic;
            color: var(--rose-gold);
            margin-top: 0.5rem;
            position: relative;
        }

        /* ─── TOOLBAR DE BUSCA E FILTROS ─── */
        .lembrancas-toolbar {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem 1.5rem 1rem;
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        .search-box {
            flex: 1;
            min-width: 220px;
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.75rem;
            border: 1.5px solid rgba(201, 149, 108, 0.25);
            border-radius: var(--radius-pill);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            background: white;
            color: var(--dark-2);
            transition: border-color var(--transition-fast);
            outline: none;
        }

        .search-box input:focus { border-color: var(--rose-gold); }

        .search-box i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--cor-gray);
            pointer-events: none;
        }

        .filtros {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .filtro-btn {
            padding: 0.55rem 1.1rem;
            border: 1.5px solid rgba(201, 149, 108, 0.25);
            background: white;
            color: var(--dark-3);
            border-radius: var(--radius-pill);
            font-family: 'Inter', sans-serif;
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .filtro-btn:hover, .filtro-btn.ativo {
            background: var(--bordo);
            border-color: var(--bordo);
            color: var(--marfim);
        }

        /* ─── CONTADORES ─── */
        .lembrancas-stats {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem 1.5rem;
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .stat-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 0.3rem 0.85rem;
            background: rgba(201, 149, 108, 0.1);
            color: var(--rose-gold-dark);
            border-radius: var(--radius-pill);
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.04em;
        }

        /* ─── GRID MASONRY ─── */
        .lembrancas-grid {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.5rem 4rem;
            columns: 3;
            column-gap: 1.5rem;
        }

        @media (max-width: 900px) { .lembrancas-grid { columns: 2; } }
        @media (max-width: 560px) { .lembrancas-grid { columns: 1; } }

        /* ─── CARD DE LEMBRANÇA ─── */
        .lembranca-card {
            break-inside: avoid;
            margin-bottom: 1.5rem;
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(201, 149, 108, 0.1);
            overflow: hidden;
            transition: all var(--transition-med);
            opacity: 1;
        }

        .lembranca-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(201, 149, 108, 0.25);
        }

        .lembranca-card.oculto {
            display: none;
        }

        /* Foto */
        .lembranca-foto {
            width: 100%;
            display: block;
            object-fit: cover;
        }

        .lembranca-foto-placeholder {
            width: 100%;
            padding: 2rem 1rem;
            background: linear-gradient(135deg, var(--marfim-dark), var(--nude-light));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: rgba(90, 28, 53, 0.3);
        }

        /* Conteúdo do card */
        .lembranca-corpo {
            padding: 1.25rem 1.5rem 1rem;
        }

        .lembranca-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.6rem;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .lembranca-data {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--rose-gold-dark);
        }

        .lembranca-local {
            font-size: 0.72rem;
            color: var(--cor-gray);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .lembranca-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--bordo);
            line-height: 1.3;
            margin-bottom: 0.6rem;
        }

        .lembranca-descricao {
            font-family: 'Inter', sans-serif;
            font-size: 0.86rem;
            line-height: 1.75;
            color: var(--dark-3);
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .lembranca-descricao.expandida {
            display: block;
            -webkit-line-clamp: unset;
        }

        /* Tags */
        .lembranca-tags {
            margin-top: 0.85rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .tag {
            padding: 0.2rem 0.6rem;
            background: rgba(201, 149, 108, 0.1);
            color: var(--rose-gold-dark);
            border-radius: var(--radius-pill);
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            cursor: pointer;
            transition: all var(--transition-fast);
        }

        .tag:hover {
            background: var(--rose-gold);
            color: white;
        }

        /* Ações do card */
        .lembranca-acoes {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem 1rem;
            border-top: 1px solid rgba(201, 149, 108, 0.08);
        }

        .btn-favoritar {
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            padding: 0.2rem;
            line-height: 1;
            transition: transform var(--transition-fast);
            color: var(--cor-gray);
        }

        .btn-favoritar:hover { transform: scale(1.3); }
        .btn-favoritar.favoritado { color: #e74c3c; }

        .btn-expandir {
            background: none;
            border: none;
            font-size: 0.75rem;
            color: var(--rose-gold-dark);
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            margin-left: auto;
            padding: 0;
        }

        .btn-acao-sm {
            padding: 0.25rem 0.65rem;
            font-size: 0.72rem;
            border-radius: var(--radius-sm);
            border: 1px solid;
            background: transparent;
            cursor: pointer;
            transition: all var(--transition-fast);
            font-family: 'Inter', sans-serif;
        }

        .btn-editar-sm {
            border-color: rgba(90, 28, 53, 0.25);
            color: var(--bordo);
        }

        .btn-editar-sm:hover { background: var(--bordo); color: var(--marfim); }

        .btn-deletar-sm {
            border-color: rgba(220, 80, 80, 0.25);
            color: #c0392b;
        }

        .btn-deletar-sm:hover { background: #c0392b; color: white; }

        /* ─── ESTADO VAZIO ─── */
        .empty-state {
            text-align: center;
            padding: 5rem 2rem;
            grid-column: 1/-1;
        }

        /* ─── BOTÃO SURPRESA ─── */
        .btn-surpresa-wrapper {
            text-align: center;
            padding: 2rem 1rem 1rem;
        }

        /* ─── MODAL FORM ─── */
        .modal-lem {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(20, 8, 14, 0.82);
            backdrop-filter: blur(10px);
            z-index: var(--z-modal);
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-lem.show { display: flex; }

        .modal-lem-conteudo {
            background: white;
            border-radius: var(--radius-xl);
            padding: 2.5rem;
            width: 100%;
            max-width: 580px;
            max-height: 92vh;
            overflow-y: auto;
            box-shadow: var(--shadow-xl);
            animation: scaleIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .modal-lem-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--bordo);
            margin-bottom: 1.75rem;
        }

        .form-label-p {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--bordo);
            margin-bottom: 0.3rem;
            display: block;
        }

        .form-ctrl {
            width: 100%;
            padding: 0.72rem 1rem;
            border: 1.5px solid rgba(201, 149, 108, 0.3);
            border-radius: var(--radius-sm);
            font-family: 'Inter', sans-serif;
            font-size: 0.88rem;
            color: var(--dark-2);
            background: var(--marfim);
            transition: border-color var(--transition-fast);
            outline: none;
        }
        .form-ctrl:focus { border-color: var(--rose-gold); background: white; }
        textarea.form-ctrl { resize: vertical; min-height: 90px; }

        /* ─── BOTÃO ADICIONAR FLUTUANTE ─── */
        .btn-adicionar-fab {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--bordo), var(--bordo-light));
            color: white;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 6px 24px rgba(90, 28, 53, 0.4);
            transition: all var(--transition-fast);
            z-index: 500;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-adicionar-fab:hover {
            transform: scale(1.1) rotate(45deg);
            box-shadow: 0 10px 32px rgba(90, 28, 53, 0.55);
        }

        /* Toast de notificação */
        .toast-notif {
            position: fixed;
            bottom: 5.5rem;
            right: 2rem;
            background: var(--dark);
            color: var(--marfim);
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius-md);
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            z-index: var(--z-toast);
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.3s ease;
            pointer-events: none;
        }
        .toast-notif.show {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>

<div id="floating-hearts-container"></div>

