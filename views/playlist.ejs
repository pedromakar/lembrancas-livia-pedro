<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nossa Playlist — Nosso Lugar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: var(--dark); color: var(--marfim); min-height: 100vh; padding-bottom: 6rem; }

        /* ─── HERO ─── */
        .playlist-hero {
            background: linear-gradient(180deg, rgba(90,28,53,0.6) 0%, var(--dark) 100%);
            padding: 4rem 2rem 3rem;
            text-align: center;
            position: relative;
        }

        .playlist-cover {
            width: 180px;
            height: 180px;
            border-radius: var(--radius-lg);
            background: linear-gradient(135deg, var(--bordo), var(--rose-gold-dark), var(--bordo-light));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            margin: 0 auto 1.5rem;
            box-shadow: 0 16px 48px rgba(90,28,53,0.6);
            animation: float 4s ease-in-out infinite;
        }

        .playlist-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 700;
            color: var(--marfim);
            margin-bottom: 0.25rem;
        }

        .playlist-hero p {
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            color: rgba(253,248,245,0.5);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .playlist-hero-stats {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .playlist-stat { font-size: 0.8rem; color: rgba(253,248,245,0.5); }
        .playlist-stat strong { color: var(--rose-gold); font-weight: 600; }

        /* ─── CONTROLES ─── */
        .playlist-controls {
            max-width: 800px;
            margin: 2rem auto 0;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-play-all {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.85rem 2rem;
            background: var(--rose-gold);
            color: var(--dark);
            border: none;
            border-radius: var(--radius-pill);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all var(--transition-fast);
            text-decoration: none;
        }
        .btn-play-all:hover { background: var(--rose-gold-light); transform: scale(1.04); color: var(--dark); }

        .btn-add-music {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.8rem 1.5rem;
            background: transparent;
            color: rgba(253,248,245,0.7);
            border: 1.5px solid rgba(253,248,245,0.2);
            border-radius: var(--radius-pill);
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition-fast);
        }
        .btn-add-music:hover { border-color: var(--rose-gold); color: var(--rose-gold); }

        /* ─── LISTA DE MÚSICAS ─── */
        .tracks-list {
            max-width: 800px;
            margin: 2.5rem auto 0;
            padding: 0 1.5rem;
        }

        .tracks-header {
            display: grid;
            grid-template-columns: 40px 1fr 80px 80px;
            gap: 1rem;
            padding: 0 1rem 0.75rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            margin-bottom: 0.5rem;
        }
        .tracks-header span {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(253,248,245,0.35);
        }

        .track-item {
            display: grid;
            grid-template-columns: 40px 1fr 80px 80px;
            gap: 1rem;
            align-items: center;
            padding: 0.75rem 1rem;
            border-radius: var(--radius-md);
            transition: background var(--transition-fast);
            cursor: pointer;
            position: relative;
        }
        .track-item:hover { background: rgba(255,255,255,0.06); }
        .track-item.playing { background: rgba(201,149,108,0.1); }

        .track-num {
            font-size: 0.9rem;
            color: rgba(253,248,245,0.4);
            text-align: center;
            font-family: 'Inter', sans-serif;
            position: relative;
        }

        .track-play-icon {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            color: var(--rose-gold);
            font-size: 0.9rem;
        }

        .track-item:hover .track-num-text { display: none; }
        .track-item:hover .track-play-icon { display: block; }

        .track-cover {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg, var(--bordo), var(--rose-gold-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .track-info { overflow: hidden; }

        .track-nome {
            font-family: 'Inter', sans-serif;
            font-size: 0.92rem;
            font-weight: 500;
            color: var(--marfim);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-item.playing .track-nome { color: var(--rose-gold); }

        .track-artista {
            font-size: 0.78rem;
            color: rgba(253,248,245,0.45);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 2px;
        }

        .track-memoria {
            font-size: 0.75rem;
            color: rgba(201,149,108,0.6);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-duracao {
            font-size: 0.82rem;
            color: rgba(253,248,245,0.4);
            font-family: 'Inter', sans-serif;
            text-align: right;
        }

        .track-acoes {
            display: flex;
            gap: 0.3rem;
            justify-content: flex-end;
            opacity: 0;
            transition: opacity var(--transition-fast);
        }
        .track-item:hover .track-acoes { opacity: 1; }

        .btn-track-acao {
            background: none;
            border: none;
            color: rgba(253,248,245,0.5);
            font-size: 0.8rem;
            cursor: pointer;
            padding: 0.2rem 0.4rem;
            border-radius: var(--radius-sm);
            transition: all var(--transition-fast);
        }
        .btn-track-acao:hover { color: var(--rose-gold); background: rgba(201,149,108,0.1); }

        /* ─── PLAYER INFERIOR ─── */
        .music-player-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(18,5,12,0.98);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(201,149,108,0.12);
            padding: 0.85rem 1.5rem;
            z-index: var(--z-player);
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 1rem;
        }

        .player-track-info { display: flex; align-items: center; gap: 0.85rem; min-width: 0; }
        .player-track-cover { width: 48px; height: 48px; border-radius: var(--radius-sm); background: linear-gradient(135deg,var(--bordo),var(--rose-gold-dark)); display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0; }
        .player-track-nome { font-size: 0.85rem; font-weight: 600; color: var(--marfim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .player-track-artista { font-size: 0.75rem; color: rgba(253,248,245,0.45); }

        .player-controls { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
        .player-btns { display: flex; align-items: center; gap: 1rem; }

        .btn-player {
            background: none;
            border: none;
            color: rgba(253,248,245,0.7);
            font-size: 1.1rem;
            cursor: pointer;
            padding: 0.3rem;
            transition: all var(--transition-fast);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-player:hover { color: var(--marfim); transform: scale(1.1); }
        .btn-player.btn-play-pause { width: 40px; height: 40px; border-radius: 50%; background: var(--rose-gold); color: var(--dark); font-size: 1rem; }
        .btn-player.btn-play-pause:hover { background: var(--rose-gold-light); transform: scale(1.06); }

        .player-progress { width: 100%; max-width: 360px; display: flex; align-items: center; gap: 0.6rem; }
        .progress-time { font-size: 0.65rem; color: rgba(253,248,245,0.35); font-family:'Inter',sans-serif; min-width: 28px; }
        .progress-bar { flex: 1; height: 3px; background: rgba(255,255,255,0.15); border-radius: 3px; cursor: pointer; position: relative; }
        .progress-fill { height: 100%; background: var(--rose-gold); border-radius: 3px; width: 0%; transition: width 0.5s linear; }
        .progress-bar:hover .progress-fill { background: var(--rose-gold-light); }

        .player-right { display: flex; align-items: center; justify-content: flex-end; gap: 0.75rem; }
        .player-vol { display: flex; align-items: center; gap: 0.5rem; }
        .vol-icon { color: rgba(253,248,245,0.45); font-size: 0.85rem; }
        .vol-slider { width: 80px; accent-color: var(--rose-gold); cursor: pointer; }

        /* ─── MODAL FORM MÚSICA ─── */
        .modal-mus { display:none; position:fixed; inset:0; background:rgba(20,8,14,0.9); backdrop-filter:blur(12px); z-index:calc(var(--z-modal)+10); align-items:center; justify-content:center; padding:1rem; }
        .modal-mus.show { display:flex; }
        .modal-mus-c { background:var(--dark-2); border:1px solid rgba(201,149,108,0.15); border-radius:var(--radius-xl); padding:2.5rem; width:100%; max-width:520px; max-height:90vh; overflow-y:auto; box-shadow:var(--shadow-xl); animation:scaleIn 0.35s cubic-bezier(0.16,1,0.3,1); }
        .modal-mus-titulo { font-family:'Cormorant Garamond',serif; font-size:1.8rem; font-weight:600; color:var(--marfim); margin-bottom:1.75rem; }
        .fld { font-size:0.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--rose-gold-dark); margin-bottom:.35rem; display:block; }
        .fctrl { width:100%; padding:.72rem 1rem; border:1.5px solid rgba(201,149,108,0.2); border-radius:var(--radius-sm); font-family:'Inter',sans-serif; font-size:.88rem; color:var(--marfim); background:rgba(255,255,255,0.05); transition:border-color var(--transition-fast); outline:none; }
        .fctrl:focus { border-color:var(--rose-gold); background:rgba(255,255,255,0.08); }
        textarea.fctrl { resize:vertical; min-height:80px; }

        /* Embed player */
        .embed-player { display:none; margin-top:0.5rem; }
        .embed-player iframe { width:100%; border-radius:var(--radius-md); border:none; }

        @media (max-width:600px) {
            .tracks-header { display:none; }
            .track-item { grid-template-columns: 44px 1fr 60px; }
            .track-item .track-duracao { display:none; }
            .music-player-bar { grid-template-columns: 1fr auto; }
            .player-right { display:none; }
        }
    </style>
</head>
<body>
<div id="floating-hearts-container"></div>

<!-- SIDEBAR -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div><div class="sidebar-title">Nosso Lugar</div><div class="sidebar-sub"><%= config.casal.nome1 %> & <%= config.casal.nome2 %></div></div>
        <button class="btn-close btn-close-white" id="sidebarClose"></button>
    </div>
    <ul class="sidebar-menu">
        <li><a href="/"><span class="menu-icon">🏠</span> Início</a></li>
        <li><a href="/historia"><span class="menu-icon">❤️</span> Nossa História</a></li>
        <li><a href="/lembrancas"><span class="menu-icon">📸</span> Lembranças</a></li>
        <li><a href="/cartas"><span class="menu-icon">💌</span> Cartas</a></li>
        <li><a href="/jogos"><span class="menu-icon">🎮</span> Jogos</a></li>
        <li><a href="/playlist" class="active"><span class="menu-icon">🎵</span> Playlist</a></li>
        <li><a href="/lugares"><span class="menu-icon">🗺️</span> Lugares</a></li>
        <li><a href="/estatisticas"><span class="menu-icon">📊</span> Estatísticas</a></li>
    </ul>
</div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- NAVBAR (dark no dark bg) -->
<nav class="navbar navbar-expand-lg navbar-dark" style="background:transparent!important; box-shadow:none; border-bottom:1px solid rgba(255,255,255,0.06);">
    <div class="container-fluid px-4">
        <button class="btn btn-link text-white p-2 me-2" id="sidebarToggle"><i class="fas fa-bars"></i></button>
        <a class="navbar-brand" href="/">❤️ Nosso Lugar</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Início</a></li>
                    <li class="nav-item"><a class="nav-link" href="/cartas"><i class="fas fa-envelope me-1"></i>Cartas</a></li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-highlight" href="/jogos" style="background: rgba(255, 255, 255, 0.25); border-radius: 20px; padding: 5px 15px !important; font-weight: bold; border: 1px solid rgba(255, 255, 255, 0.4); box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                            <i class="fas fa-gamepad"></i> 🎮 Jogos
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/lembrancas"><i class="fas fa-images me-1"></i>Lembranças</a></li>
                    <li class="nav-item"><a class="nav-link" href="/historia"><i class="fas fa-book-heart me-1"></i>História</a></li>
                    <li class="nav-item"><a class="nav-link" href="/playlist"><i class="fas fa-music me-1"></i>Playlist</a></li>
                    <li class="nav-item"><a class="nav-link" href="/lugares"><i class="fas fa-map-marker-alt me-1"></i>Lugares</a></li>
                    <li class="nav-item"><a class="nav-link" href="/estatisticas"><i class="fas fa-chart-pie me-1"></i>Estatísticas</a></li>
                </ul>
        </div>
    </div>
</nav>

<!-- HERO -->
<div class="playlist-hero">
    <div class="playlist-cover">🎵</div>
    <h1 class="animate-fadeInUp">Nossa Playlist</h1>
    <p class="animate-fadeInUp delay-2"><%= config.casal.nome1 %> & <%= config.casal.nome2 %></p>
    <div class="playlist-hero-stats animate-fadeInUp delay-3">
        <span class="playlist-stat"><strong><%= musicas.length %></strong> músicas</span>
        <span class="playlist-stat">· Trilha sonora da nossa história</span>
    </div>

    <div class="playlist-controls animate-fadeInUp delay-4">
        <button class="btn-play-all" id="btnPlayAll"><i class="fas fa-play"></i> Reproduzir tudo</button>
        <button class="btn-add-music" id="btnAddMusic"><i class="fas fa-plus"></i> Adicionar música</button>
    </div>
</div>

<!-- LISTA DE MÚSICAS -->
<div class="tracks-list">
    <div class="tracks-header">
        <span>#</span>
        <span>TÍTULO</span>
        <span>MEMÓRIA</span>
        <span style="text-align:right;">DURAÇÃO</span>
    </div>

    <% if (musicas && musicas.length > 0) { %>
        <% musicas.forEach(function(m, i) { %>
        <div class="track-item reveal" id="track-<%= m.id %>"
             data-id="<%= m.id %>"
             data-url="<%= m.url || '' %>"
             data-titulo="<%= m.titulo %>"
             data-artista="<%= m.artista || '' %>"
             onclick="selecionarTrack(<%= m.id %>)">

            <div class="track-num">
                <span class="track-num-text"><%= i + 1 %></span>
                <i class="fas fa-play track-play-icon"></i>
            </div>

            <div style="display:flex; align-items:center; gap:0.85rem; min-width:0;">
                <div class="track-cover">🎵</div>
                <div class="track-info">
                    <div class="track-nome"><%= m.titulo %></div>
                    <div class="track-artista"><%= m.artista || 'Artista' %></div>
                    <% if (m.memoria) { %>
                    <div class="track-memoria">"<%= m.memoria %>"</div>
                    <% } %>
                </div>
            </div>

            <div class="track-duracao"><%= m.duracao || '--:--' %></div>

            <div class="track-acoes" onclick="event.stopPropagation()">
                <button class="btn-track-acao" title="Editar" onclick="abrirModalEditar(<%= m.id %>, this)"
                    data-id="<%= m.id %>"
                    data-titulo="<%= m.titulo %>"
                    data-artista="<%= m.artista || '' %>"
                    data-duracao="<%= m.duracao || '' %>"
                    data-memoria="<%= (m.memoria || '').replace(/\"/g, '&quot;') %>"
                    data-url="<%= m.url || '' %>">
                    <i class="fas fa-pencil-alt"></i>
                </button>
                <form action="/playlist/deletar/<%= m.id %>" method="POST" style="display:inline;"
                      onsubmit="return confirm('Remover esta música?')">
                    <button type="submit" class="btn-track-acao" title="Remover"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <div style="text-align:center; padding:4rem 1rem; color:rgba(253,248,245,0.3);">
            <div style="font-size:3rem; margin-bottom:1rem;">🎵</div>
            <p style="font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-style:italic;">A trilha sonora está esperando...</p>
        </div>
    <% } %>
</div>

<!-- PLAYER INFERIOR -->
<div class="music-player-bar" id="musicPlayer">
    <div class="player-track-info">
        <div class="player-track-cover" id="playerCover">🎵</div>
        <div>
            <div class="player-track-nome" id="playerNome">Selecione uma música</div>
            <div class="player-track-artista" id="playerArtista">—</div>
        </div>
    </div>

    <div class="player-controls">
        <div class="player-btns">
            <button class="btn-player" id="btnPrev" title="Anterior"><i class="fas fa-backward-step"></i></button>
            <button class="btn-player btn-play-pause" id="btnPlayPause"><i class="fas fa-play"></i></button>
            <button class="btn-player" id="btnNext" title="Próxima"><i class="fas fa-forward-step"></i></button>
        </div>
        <div class="player-progress">
            <span class="progress-time" id="timeNow">0:00</span>
            <div class="progress-bar" id="progressBar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <span class="progress-time" id="timeTotal">0:00</span>
        </div>
    </div>

    <div class="player-right">
        <div class="player-vol">
            <i class="fas fa-volume-medium vol-icon"></i>
            <input type="range" class="vol-slider" id="volSlider" min="0" max="100" value="80">
        </div>
    </div>
</div>

<!-- Embed (iframe oculto para YouTube/Spotify) -->
<div class="embed-player" id="embedPlayer">
    <iframe id="embedIframe" src="" allowfullscreen allow="autoplay; encrypted-media"></iframe>
</div>
<audio id="audioPlayer" style="display:none;"></audio>

<!-- MODAL FORM MÚSICA -->
<div class="modal-mus" id="modalMusica">
    <div class="modal-mus-c">
        <h2 class="modal-mus-titulo" id="modalMusTitulo">Adicionar Música</h2>
        <form id="formMusica" action="/playlist/criar" method="POST">
            <div class="mb-3"><label class="fld">Título da Música</label><input type="text" class="fctrl" name="titulo" id="mTitulo" required placeholder="Ex: Perfect"></div>
            <div class="mb-3"><label class="fld">Artista</label><input type="text" class="fctrl" name="artista" id="mArtista" placeholder="Ex: Ed Sheeran"></div>
            <div class="row mb-3">
                <div class="col-sm-6"><label class="fld">Duração</label><input type="text" class="fctrl" name="duracao" id="mDuracao" placeholder="Ex: 3:45"></div>
            </div>
            <div class="mb-3"><label class="fld">Link (YouTube, Spotify ou MP3)</label><input type="text" class="fctrl" name="url" id="mUrl" placeholder="https://..."></div>
            <div class="mb-4"><label class="fld">Memória / Por que essa música?</label><textarea class="fctrl" name="memoria" id="mMemoria" placeholder="Ex: A música que tocava quando..."></textarea></div>
            <div style="display:flex; gap:.75rem; justify-content:flex-end;">
                <button type="button" id="btnCancelarMus" style="padding:.6rem 1.25rem; font-size:.85rem; background:none; border:1px solid rgba(201,149,108,0.3); color:var(--rose-gold); border-radius:var(--radius-sm); cursor:pointer;">Cancelar</button>
                <button type="submit" class="btn-play-all" style="padding:.7rem 1.75rem;">Salvar Música</button>
            </div>
        </form>
    </div>
</div>

<script>
const musicasData = <%- JSON.stringify(musicas) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script src="/js/animations.js"></script>
<script>
    // Sidebar
    const sidebar=document.getElementById('sidebar'),sidebarToggle=document.getElementById('sidebarToggle'),sidebarClose=document.getElementById('sidebarClose'),sidebarOverlay=document.getElementById('sidebarOverlay');
    const openSb=()=>{sidebar.classList.add('active');sidebarOverlay.classList.add('active');document.body.style.overflow='hidden';};
    const closeSb=()=>{sidebar.classList.remove('active');sidebarOverlay.classList.remove('active');document.body.style.overflow='';};
    sidebarToggle.addEventListener('click',openSb);sidebarClose.addEventListener('click',closeSb);sidebarOverlay.addEventListener('click',closeSb);
    document.querySelectorAll('.sidebar-menu a').forEach(l=>l.addEventListener('click',closeSb));

    // ── Player ────────────────────────────────────────────────────
    let currentIndex = -1;
    let isPlaying = false;
    const audio = document.getElementById('audioPlayer');

    function formatTime(s) {
        if (isNaN(s)) return '0:00';
        const m = Math.floor(s/60), sec = Math.floor(s%60);
        return `${m}:${sec.toString().padStart(2,'0')}`;
    }

    function getEmbedUrl(url) {
        if (!url) return null;
        // YouTube
        const ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([A-Za-z0-9_-]{11})/);
        if (ytMatch) return `https://www.youtube.com/embed/${ytMatch[1]}?autoplay=1&rel=0`;
        // Spotify track
        const spMatch = url.match(/open\.spotify\.com\/track\/([A-Za-z0-9]+)/);
        if (spMatch) return `https://open.spotify.com/embed/track/${spMatch[1]}`;
        return null;
    }

    function selecionarTrack(id) {
        const idx = musicasData.findIndex(m => m.id === id);
        if (idx === -1) return;
        currentIndex = idx;
        const m = musicasData[idx];

        // Marca item ativo
        document.querySelectorAll('.track-item').forEach(el => el.classList.remove('playing'));
        const el = document.getElementById(`track-${id}`);
        if (el) el.classList.add('playing');

        // Atualiza info do player
        document.getElementById('playerNome').textContent    = m.titulo;
        document.getElementById('playerArtista').textContent = m.artista || '—';
        document.getElementById('btnPlayPause').innerHTML    = '<i class="fas fa-pause"></i>';
        isPlaying = true;

        const embedUrl = getEmbedUrl(m.url);
        if (embedUrl) {
            // Usa iframe embed
            audio.pause(); audio.src = '';
            document.getElementById('embedIframe').src = embedUrl;
            document.getElementById('embedPlayer').style.display = 'none'; // oculto mas ativo
        } else if (m.url && (m.url.endsWith('.mp3') || m.url.includes('.mp3'))) {
            // MP3 direto
            document.getElementById('embedIframe').src = '';
            audio.src = m.url;
            audio.volume = document.getElementById('volSlider').value / 100;
            audio.play().catch(()=>{});
        } else if (m.url) {
            window.open(m.url, '_blank');
        }
    }

    // Prev / Next
    function prevTrack() {
        if (musicasData.length === 0) return;
        currentIndex = (currentIndex - 1 + musicasData.length) % musicasData.length;
        selecionarTrack(musicasData[currentIndex].id);
    }

    function nextTrack() {
        if (musicasData.length === 0) return;
        currentIndex = (currentIndex + 1) % musicasData.length;
        selecionarTrack(musicasData[currentIndex].id);
    }

    document.getElementById('btnPrev').addEventListener('click', prevTrack);
    document.getElementById('btnNext').addEventListener('click', nextTrack);

    document.getElementById('btnPlayPause').addEventListener('click', () => {
        if (currentIndex === -1) { if (musicasData.length) selecionarTrack(musicasData[0].id); return; }
        if (isPlaying) {
            audio.pause();
            document.getElementById('btnPlayPause').innerHTML = '<i class="fas fa-play"></i>';
            isPlaying = false;
        } else {
            audio.play().catch(()=>{});
            document.getElementById('btnPlayPause').innerHTML = '<i class="fas fa-pause"></i>';
            isPlaying = true;
        }
    });

    document.getElementById('btnPlayAll').addEventListener('click', () => {
        if (musicasData.length) selecionarTrack(musicasData[0].id);
    });

    // Progresso do audio
    audio.addEventListener('timeupdate', () => {
        if (!audio.duration) return;
        const pct = (audio.currentTime / audio.duration) * 100;
        document.getElementById('progressFill').style.width = pct + '%';
        document.getElementById('timeNow').textContent   = formatTime(audio.currentTime);
        document.getElementById('timeTotal').textContent = formatTime(audio.duration);
    });

    audio.addEventListener('ended', nextTrack);

    // Clique na progress bar
    document.getElementById('progressBar').addEventListener('click', function(e) {
        if (!audio.duration) return;
        const rect = this.getBoundingClientRect();
        audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
    });

    // Volume
    document.getElementById('volSlider').addEventListener('input', function() {
        audio.volume = this.value / 100;
    });

    // ── Modal Música ──────────────────────────────────────────────
    const modalMusica = document.getElementById('modalMusica');
    const formMusica  = document.getElementById('formMusica');
    const openModal   = () => { formMusica.reset(); document.getElementById('modalMusTitulo').textContent = 'Adicionar Música'; formMusica.action = '/playlist/criar'; modalMusica.classList.add('show'); document.body.style.overflow='hidden'; };
    const closeModal  = () => { modalMusica.classList.remove('show'); document.body.style.overflow=''; };

    document.getElementById('btnAddMusic').addEventListener('click', openModal);
    document.getElementById('btnCancelarMus').addEventListener('click', closeModal);
    modalMusica.addEventListener('click', e => { if (e.target===modalMusica) closeModal(); });

    window.abrirModalEditar = function(id, btn) {
        const d = btn.dataset;
        document.getElementById('modalMusTitulo').textContent = 'Editar Música';
        formMusica.action = `/playlist/editar/${id}`;
        document.getElementById('mTitulo').value  = d.titulo   || '';
        document.getElementById('mArtista').value = d.artista  || '';
        document.getElementById('mDuracao').value = d.duracao  || '';
        document.getElementById('mUrl').value     = d.url      || '';
        document.getElementById('mMemoria').value = d.memoria  || '';
        modalMusica.classList.add('show');
        document.body.style.overflow='hidden';
    };
</script>
</body>
</html>