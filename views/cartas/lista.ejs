<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nossas Cartas — Nosso Lugar</title>
    <meta name="description" content="Cartas de amor escritas com carinho, guardadas para sempre.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: var(--marfim); }

        /* ══════════════════════════════════════════════
           HERO
        ══════════════════════════════════════════════ */
        .cartas-hero {
            background: linear-gradient(160deg, #1a0a12 0%, #2b1019 50%, #3d1830 100%);
            color: var(--marfim);
            padding: 5rem 1.5rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .cartas-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 70% 40%, rgba(201,149,108,0.1) 0%, transparent 65%);
        }
        .hero-line { width: 60px; height: 1px; background: linear-gradient(90deg, transparent, var(--rose-gold), transparent); margin: 0 auto 1.5rem; }
        .cartas-hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2.8rem, 7vw, 4.5rem);
            font-weight: 600;
            letter-spacing: -0.02em;
            position: relative;
        }
        .cartas-hero p { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; font-style: italic; color: var(--rose-gold); margin-top: 0.5rem; position: relative; }

        /* ══════════════════════════════════════════════
           GRID DE ENVELOPES
        ══════════════════════════════════════════════ */
        .cartas-grid {
            max-width: 1100px;
            margin: 3rem auto;
            padding: 0 1.5rem 5rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2.5rem;
        }

        /* ══════════════════════════════════════════════
           ENVELOPE 3D
        ══════════════════════════════════════════════ */
        .envelope-scene {
            perspective: 800px;
            width: 100%;
        }

        .envelope-wrapper {
            position: relative;
            width: 100%;
            padding-bottom: 72%; /* proporção envelope */
            cursor: pointer;
            transform-style: preserve-3d;
        }

        .envelope {
            position: absolute;
            inset: 0;
            transform-style: preserve-3d;
            transition: transform 0.3s ease;
        }
        .envelope:hover { transform: translateY(-6px) scale(1.02); }
        .envelope:hover .envelope-shadow { box-shadow: 0 30px 60px rgba(90,28,53,0.35); }

        /* Sombra suave abaixo */
        .envelope-shadow {
            position: absolute;
            bottom: -10px;
            left: 5%;
            right: 5%;
            height: 20px;
            background: radial-gradient(ellipse, rgba(90,28,53,0.22) 0%, transparent 70%);
            transition: all 0.4s ease;
            pointer-events: none;
        }

        /* ── CORPO DO ENVELOPE ── */
        .envelope-body {
            position: absolute;
            inset: 0;
            background: #f5efe6;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(90,28,53,0.18), inset 0 0 0 1px rgba(180,140,100,0.3);
        }

        /* Triângulos internos decorativos (linhas diagonais do envelope) */
        .envelope-body::before,
        .envelope-body::after {
            content: '';
            position: absolute;
            bottom: 0;
            width: 0;
            height: 0;
        }
        /* Triângulo esquerdo */
        .envelope-body::before {
            left: 0;
            border-style: solid;
            border-width: 0 0 55% 50%;
            border-color: transparent transparent #e8ddd0 transparent;
        }
        /* Triângulo direito */
        .envelope-body::after {
            right: 0;
            border-style: solid;
            border-width: 0 50% 55% 0;
            border-color: transparent #e8ddd0 transparent transparent;
        }

        /* Listra estilo airmail */
        .envelope-airmail {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: repeating-linear-gradient(
                90deg,
                #5a1c35 0px, #5a1c35 12px,
                #fff 12px, #fff 18px
            );
            opacity: 0.6;
        }

        /* Carimbo decorativo */
        .envelope-stamp {
            position: absolute;
            top: 12px;
            right: 14px;
            width: 44px;
            height: 52px;
            background: white;
            border: 2px solid #c9956c;
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 1px 1px 4px rgba(0,0,0,0.15);
            z-index: 4;
            /* borda serrilhada tipo carimbo */
            background-image: radial-gradient(circle, transparent 3px, white 3px);
            background-size: 8px 8px;
            background-position: -4px -4px;
        }
        .envelope-stamp-inner {
            background: white;
            width: 36px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            border-radius: 2px;
        }

        /* Lacre de cera no centro */
        .envelope-seal {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 52px;
            height: 52px;
            background: radial-gradient(circle at 35% 35%, #8b2040, #5a1c35 60%, #3d1220);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            box-shadow: 0 4px 12px rgba(90,28,53,0.5), inset 0 2px 4px rgba(255,255,255,0.2);
            z-index: 4;
            transition: transform 0.4s ease, opacity 0.4s ease;
        }
        .envelope.aberto .envelope-seal {
            transform: translate(-50%, -50%) scale(0);
            opacity: 0;
        }

        /* Título e data impressos no corpo */
        .envelope-label {
            position: absolute;
            bottom: 20%;
            left: 0;
            right: 0;
            text-align: center;
            z-index: 3;
            padding: 0 1rem;
            transition: opacity 0.3s ease;
        }
        .envelope.aberto .envelope-label { opacity: 0; }

        .label-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(0.85rem, 2vw, 1.05rem);
            font-weight: 600;
            color: #5a1c35;
            line-height: 1.3;
            margin-bottom: 0.2rem;
        }
        .label-data {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #c9956c;
        }

        /* ── ABA DO ENVELOPE (FLAP) ── */
        .envelope-flap {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 50%;
            transform-origin: top center;
            transform-style: preserve-3d;
            transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 5;
        }
        .envelope.aberto .envelope-flap {
            transform: rotateX(-180deg);
        }

        /* Face frontal da aba (visível quando fechada) */
        .flap-front {
            position: absolute;
            inset: 0;
            background: #ede4d5;
            clip-path: polygon(0 0, 100% 0, 50% 100%);
            backface-visibility: hidden;
            box-shadow: 0 4px 12px rgba(90,28,53,0.12);
            border-top: 1px solid rgba(180,140,100,0.35);
            border-left: 1px solid rgba(180,140,100,0.2);
            border-right: 1px solid rgba(180,140,100,0.2);
        }
        /* Face traseira da aba (visível quando aberta) */
        .flap-back {
            position: absolute;
            inset: 0;
            background: #d9cfc0;
            clip-path: polygon(0 0, 100% 0, 50% 100%);
            backface-visibility: hidden;
            transform: rotateX(180deg);
        }

        /* ── PAPEL INTERNO ── */
        .envelope-paper {
            position: absolute;
            bottom: 0;
            left: 8%;
            right: 8%;
            height: 75%;
            background: #fffdfb;
            border-radius: 4px 4px 0 0;
            z-index: 2;
            transform: translateY(100%);
            transition: transform 0s;
            box-shadow: 0 -4px 20px rgba(90,28,53,0.12);
            border: 1px solid rgba(201,149,108,0.2);
            border-bottom: none;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .envelope.aberto .envelope-paper {
            transform: translateY(28%);
            transition: transform 0.55s 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .paper-content {
            text-align: center;
            padding: 1rem;
        }
        .paper-icon {
            font-size: 1.6rem;
            margin-bottom: 0.4rem;
        }
        .paper-titulo {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(0.9rem, 2.5vw, 1.1rem);
            font-weight: 600;
            color: var(--bordo);
            line-height: 1.3;
        }

        /* ── BOTÕES AÇÃO ── */
        .envelope-actions {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            gap: 4px;
            z-index: 10;
            opacity: 0;
            transition: opacity 0.2s;
        }
        .envelope-scene:hover .envelope-actions { opacity: 1; }

        .btn-acao-xs {
            padding: 0.2rem 0.5rem;
            font-size: 0.65rem;
            border-radius: 4px;
            border: 1px solid;
            background: white;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', sans-serif;
        }
        .btn-editar-xs { border-color: rgba(90,28,53,0.3); color: var(--bordo); }
        .btn-editar-xs:hover { background: var(--bordo); color: white; }
        .btn-deletar-xs { border-color: rgba(220,80,80,0.3); color: #c0392b; }
        .btn-deletar-xs:hover { background: #c0392b; color: white; }

        /* Hint de clique */
        .envelope-hint {
            text-align: center;
            margin-top: 0.75rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            color: var(--rose-gold-dark);
            letter-spacing: 0.08em;
            opacity: 0.8;
            transition: opacity 0.3s;
        }
        .envelope.aberto ~ .envelope-hint { opacity: 0; }

        /* ══════════════════════════════════════════════
           MODAL LEITURA
        ══════════════════════════════════════════════ */
        .modal-leitura {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(20,8,14,0.9);
            backdrop-filter: blur(16px);
            z-index: var(--z-modal);
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-leitura.show { display: flex; }

        .modal-papel {
            background: #fffdfb;
            border-radius: var(--radius-xl);
            padding: 3rem 2.5rem;
            width: 100%;
            max-width: 600px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-xl);
            animation: scaleIn 0.4s cubic-bezier(0.16,1,0.3,1);
            border: 1px solid rgba(201,149,108,0.2);
            position: relative;
        }
        .papel-ornamento { text-align: center; font-size: 2rem; margin-bottom: 1.5rem; animation: heartBeat 2s ease-in-out infinite; }
        .papel-data { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--rose-gold-dark); text-align: center; margin-bottom: 0.5rem; }
        .papel-titulo { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 600; color: var(--bordo); text-align: center; margin-bottom: 0.75rem; }
        .papel-divider { width: 80px; height: 1px; background: linear-gradient(90deg, transparent, var(--rose-gold), transparent); margin: 1.5rem auto; }
        .papel-corpo { font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; line-height: 2; color: var(--dark-2); white-space: pre-wrap; }
        .papel-assinar { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; font-style: italic; color: var(--bordo); text-align: right; margin-top: 2rem; }
        .btn-fechar-papel {
            position: absolute; top: 1.25rem; right: 1.25rem; background: none; border: none;
            font-size: 1.2rem; cursor: pointer; color: var(--cor-gray); transition: all var(--transition-fast);
            width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
        }
        .btn-fechar-papel:hover { background: var(--marfim-dark); color: var(--bordo); }

        /* ══════════════════════════════════════════════
           MODAL FORMULÁRIO
        ══════════════════════════════════════════════ */
        .modal-form-carta { display: none; position: fixed; inset: 0; background: rgba(20,8,14,0.82); backdrop-filter: blur(10px); z-index: calc(var(--z-modal) + 1); align-items: center; justify-content: center; padding: 1rem; }
        .modal-form-carta.show { display: flex; }
        .modal-form-conteudo { background: white; border-radius: var(--radius-xl); padding: 2.5rem; width: 100%; max-width: 580px; max-height: 92vh; overflow-y: auto; box-shadow: var(--shadow-xl); animation: scaleIn 0.35s cubic-bezier(0.16,1,0.3,1); }
        .form-titulo { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 600; color: var(--bordo); margin-bottom: 1.75rem; }
        .form-label-p { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bordo); margin-bottom: 0.3rem; display: block; }
        .form-ctrl { width: 100%; padding: 0.72rem 1rem; border: 1.5px solid rgba(201,149,108,0.3); border-radius: var(--radius-sm); font-family: 'Inter', sans-serif; font-size: 0.88rem; color: var(--dark-2); background: var(--marfim); transition: border-color var(--transition-fast); outline: none; }
        .form-ctrl:focus { border-color: var(--rose-gold); background: white; }
        textarea.form-ctrl { resize: vertical; min-height: 140px; }

        /* FAB */
        .btn-fab { position: fixed; bottom: 2rem; right: 2rem; width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--bordo), var(--bordo-light)); color: white; border: none; font-size: 1.5rem; cursor: pointer; box-shadow: 0 6px 24px rgba(90,28,53,0.4); transition: all var(--transition-fast); z-index: 500; display: flex; align-items: center; justify-content: center; }
        .btn-fab:hover { transform: scale(1.1) rotate(45deg); box-shadow: 0 10px 32px rgba(90,28,53,0.55); }

        .empty-cartas { text-align: center; padding: 5rem 2rem; }

        @media (max-width: 600px) {
            .cartas-grid { grid-template-columns: 1fr; gap: 2rem; }
            .modal-papel { padding: 2rem 1.5rem; }
        }
    </style>
</head>
<body>
<div id="floating-hearts-container"></div>

